import React from "react";
import {
  Plus,
  Heart,
  MessageCircle,
  Bookmark,
  Share2,
  MoreHorizontal,
  BadgeCheck,
} from "lucide-react";

type Interest = {
  name: string;
  color: string;
};

type Post = {
  id: string;
  username: string;
  handle: string;
  avatar: string;
  time: string;
  category: string;
  text: string;
  image?: string;
  verified?: boolean;
  liked?: boolean;
  saved?: boolean;
  likes?: number;
  comments?: number;
};

const interests: Interest[] = [
  { name: "Books", color: "#6366f1" },
  { name: "Food", color: "#ef4444" },
  { name: "Fashion", color: "#a855f7" },
  { name: "Movies & TV", color: "#f97316" },
  { name: "Art & Design", color: "#ec4899" },
  { name: "Business", color: "#64748b" },
  { name: "Fitness", color: "#14b8a6" },
  { name: "Gaming", color: "#f59e0b" },
  { name: "Music", color: "#8b5cf6" },
  { name: "Photography", color: "#84cc16" },
  { name: "Sports", color: "#22c55e" },
  { name: "Travel", color: "#06b6d4" },
  { name: "Technology", color: "#3b82f6" },
  { name: "Science", color: "#0ea5e9" },
  { name: "Nature", color: "#22c55e" },
];

interface InterestPostsProps {
  posts: Post[];

  selectedInterest: string;
  setSelectedInterest: (interest: string) => void;

  selectedInterests: string[];

  activeTab: "posts" | "saved";
  setActiveTab: (tab: "posts" | "saved") => void;

  onAddInterest?: () => void;
  onCreatePost?: () => void;

  onLike?: (post: Post) => void;
  onComment?: (post: Post) => void;
  onSave?: (post: Post) => void;
  onShare?: (post: Post) => void;
  onMenu?: (post: Post) => void;
  onOpenImage?: (post: Post) => void;
}

export default function InterestPosts({
  posts,
  selectedInterest,
  setSelectedInterest,
  selectedInterests,
  activeTab,
  setActiveTab,
  onAddInterest,
  onCreatePost,
  onLike,
  onComment,
  onSave,
  onShare,
  onMenu,
  onOpenImage,
}: InterestPostsProps) {
  return (
    <section className="w-full space-y-7">
      {/* TOP NAVIGATION */}
      <div className="flex items-center border-b border-border/70">
        <button
          type="button"
          onClick={() => setActiveTab("posts")}
          className={`
            relative px-1 pb-3 mr-7 text-sm font-semibold
            transition-colors
            ${
              activeTab === "posts"
                ? "text-foreground"
                : "text-muted-foreground hover:text-foreground"
            }
          `}
        >
          Posts

          {activeTab === "posts" && (
            <span className="absolute left-0 right-0 -bottom-px h-[2px] rounded-full bg-primary" />
          )}
        </button>

        <button
          type="button"
          onClick={() => setActiveTab("saved")}
          className={`
            relative px-1 pb-3 text-sm font-semibold
            transition-colors
            ${
              activeTab === "saved"
                ? "text-foreground"
                : "text-muted-foreground hover:text-foreground"
            }
          `}
        >
          Saved

          {activeTab === "saved" && (
            <span className="absolute left-0 right-0 -bottom-px h-[2px] rounded-full bg-primary" />
          )}
        </button>
      </div>

      {/* INTEREST FILTER */}
      <div className="relative">
        <div
          className="
            flex items-center gap-2
            overflow-x-auto
            pb-1
            scrollbar-hide
            [scrollbar-width:none]
            [-ms-overflow-style:none]
          "
        >
          <button
            type="button"
            onClick={() => setSelectedInterest("All posts")}
            className={`
              flex-shrink-0
              h-9 px-3.5
              text-sm font-semibold
              border
              transition-all duration-200
              ${
                selectedInterest === "All posts"
                  ? "bg-foreground text-background border-foreground"
                  : "bg-transparent text-muted-foreground border-border hover:text-foreground hover:bg-muted"
              }
            `}
          >
            All posts
          </button>

          {interests.map((interest) => {
            const active = selectedInterest === interest.name;

            return (
              <button
                key={interest.name}
                type="button"
                onClick={() => setSelectedInterest(interest.name)}
                className={`
                  flex-shrink-0
                  flex items-center gap-2
                  h-9 px-3
                  text-sm font-medium
                  border
                  transition-all duration-200
                  ${
                    active
                      ? "bg-muted text-foreground border-border"
                      : "bg-transparent text-muted-foreground border-border/70 hover:bg-muted hover:text-foreground"
                  }
                `}
              >
                <span
                  className="w-1.5 h-1.5 rounded-full flex-shrink-0"
                  style={{ backgroundColor: interest.color }}
                />

                {interest.name}
              </button>
            );
          })}
        </div>
      </div>

      {/* YOUR INTERESTS */}
      <div className="space-y-3">
        <div className="flex items-center justify-between">
          <div>
            <h3 className="text-sm font-bold text-foreground">
              Your interests
            </h3>

            <p className="text-xs text-muted-foreground mt-0.5">
              Customize the topics you want to see
            </p>
          </div>

          <button
            type="button"
            onClick={onAddInterest}
            className="
              flex items-center gap-1.5
              text-xs font-semibold
              text-primary
              hover:text-primary/80
              transition-colors
            "
          >
            <Plus className="h-4 w-4" />
            Edit
          </button>
        </div>

        <div className="flex flex-wrap gap-x-4 gap-y-2">
          {selectedInterests.map((interestName) => {
            const interest = interests.find(
              (item) => item.name === interestName
            );

            return (
              <div
                key={interestName}
                className="flex items-center gap-2 text-sm text-muted-foreground"
              >
                <span
                  className="h-2 w-2 rounded-full"
                  style={{
                    backgroundColor: interest?.color ?? "hsl(var(--primary))",
                  }}
                />

                <span>{interestName}</span>
              </div>
            );
          })}
        </div>
      </div>

      {/* CREATE POST */}
      <button
        type="button"
        onClick={onCreatePost}
        className="
          group
          w-full
          flex items-center gap-4
          px-4 py-4
          text-left
          border border-border
          bg-card
          hover:bg-muted/50
          transition-all duration-200
        "
      >
        <div
          className="
            flex items-center justify-center
            h-10 w-10
            rounded-full
            bg-primary/10
            text-primary
            transition-transform
            group-hover:scale-105
          "
        >
          <Plus className="h-5 w-5" />
        </div>

        <div className="flex-1">
          <p className="text-sm font-bold text-foreground">
            Post to your interests
          </p>

          <p className="text-xs text-muted-foreground mt-0.5">
            Share a thought with your communities
          </p>
        </div>

        <span className="text-xs font-semibold text-muted-foreground group-hover:text-foreground transition-colors">
          Create
        </span>
      </button>

      {/* POSTS */}
      <div className="divide-y divide-border/70">
        {posts.map((post) => (
          <article
            key={post.id}
            className="
              py-6
              first:pt-0
              last:pb-2
            "
          >
            {/* POST HEADER */}
            <div className="flex items-start gap-3">
              <a
                href={`/profile/${post.handle}`}
                className="flex-shrink-0"
              >
                <img
                  src={post.avatar}
                  alt={post.username}
                  className="
                    h-10 w-10
                    rounded-full
                    object-cover
                    ring-1 ring-border/60
                  "
                />
              </a>

              <div className="min-w-0 flex-1">
                <div className="flex items-center gap-1.5 min-w-0">
                  <a
                    href={`/profile/${post.handle}`}
                    className="
                      text-[15px]
                      font-bold
                      truncate
                      hover:underline
                    "
                  >
                    {post.username}
                  </a>

                  {post.verified && (
                    <BadgeCheck
                      className="
                        h-4 w-4
                        flex-shrink-0
                        text-primary
                        fill-primary/15
                      "
                    />
                  )}
                </div>

                <p className="text-xs text-muted-foreground truncate mt-0.5">
                  @{post.handle} · {post.time}
                </p>
              </div>

              {/* CATEGORY */}
              <div className="flex items-center gap-1.5 flex-shrink-0">
                <span className="text-xs font-medium text-muted-foreground">
                  {post.category}
                </span>

                <button
                  type="button"
                  onClick={() => onMenu?.(post)}
                  aria-label="Post options"
                  className="
                    flex items-center justify-center
                    h-8 w-8
                    rounded-full
                    text-muted-foreground
                    hover:bg-muted
                    hover:text-foreground
                    transition-colors
                  "
                >
                  <MoreHorizontal className="h-4 w-4" />
                </button>
              </div>
            </div>

            {/* POST TEXT */}
            <div className="mt-4">
              <p
                className="
                  text-[15px]
                  leading-6
                  text-foreground
                  whitespace-pre-wrap
                  break-words
                "
              >
                {post.text}
              </p>
            </div>

            {/* MEDIA */}
            {post.image && (
              <button
                type="button"
                onClick={() => onOpenImage?.(post)}
                aria-label="Open image"
                className="
                  block
                  w-full
                  mt-4
                  overflow-hidden
                  bg-muted
                  cursor-zoom-in
                  focus-visible:outline-none
                  focus-visible:ring-2
                  focus-visible:ring-primary
                "
              >
                <img
                  src={post.image}
                  alt=""
                  loading="lazy"
                  className="
                    block
                    w-full
                    max-h-[600px]
                    object-cover
                    transition-transform
                    duration-300
                    hover:scale-[1.01]
                  "
                />
              </button>
            )}

            {/* ACTIONS */}
            <div className="flex items-center mt-4">
              {/* LIKE */}
              <button
                type="button"
                onClick={() => onLike?.(post)}
                aria-label={post.liked ? "Unlike post" : "Like post"}
                className={`
                  flex items-center gap-1.5
                  min-h-9
                  px-2
                  text-sm font-semibold
                  transition-colors
                  ${
                    post.liked
                      ? "text-red-500"
                      : "text-muted-foreground hover:text-red-500"
                  }
                `}
              >
                <Heart
                  className={`h-[18px] w-[18px] ${
                    post.liked ? "fill-current" : ""
                  }`}
                />

                {post.likes ? (
                  <span className="tabular-nums">{post.likes}</span>
                ) : null}
              </button>

              {/* COMMENT */}
              <button
                type="button"
                onClick={() => onComment?.(post)}
                aria-label="Open comments"
                className="
                  flex items-center gap-1.5
                  min-h-9
                  px-2
                  text-sm font-semibold
                  text-muted-foreground
                  hover:text-primary
                  transition-colors
                "
              >
                <MessageCircle className="h-[18px] w-[18px]" />

                {post.comments ? (
                  <span className="tabular-nums">{post.comments}</span>
                ) : null}
              </button>

              <div className="flex-1" />

              {/* SAVE */}
              <button
                type="button"
                onClick={() => onSave?.(post)}
                aria-label={post.saved ? "Remove from saved" : "Save post"}
                className={`
                  flex items-center justify-center
                  min-h-9
                  px-2
                  transition-colors
                  ${
                    post.saved
                      ? "text-primary"
                      : "text-muted-foreground hover:text-primary"
                  }
                `}
              >
                <Bookmark
                  className={`h-[18px] w-[18px] ${
                    post.saved ? "fill-current" : ""
                  }`}
                />
              </button>

              {/* SHARE */}
              <button
                type="button"
                onClick={() => onShare?.(post)}
                aria-label="Share post"
                className="
                  flex items-center justify-center
                  min-h-9
                  px-2
                  text-muted-foreground
                  hover:text-primary
                  transition-colors
                "
              >
                <Share2 className="h-[18px] w-[18px]" />
              </button>
            </div>
          </article>
        ))}

        {/* EMPTY / END */}
        {posts.length === 0 && (
          <div className="py-16 text-center">
            <p className="text-sm font-semibold text-foreground">
              No posts yet
            </p>

            <p className="text-xs text-muted-foreground mt-1">
              Posts from your interests will appear here.
            </p>
          </div>
        )}

        {posts.length > 0 && (
          <div className="pt-5 text-center">
            <p className="text-xs font-medium text-muted-foreground">
              You've seen all posts
            </p>
          </div>
        )}
      </div>
    </section>
  );
}